#!/bin/sh
# Short entry point for the mascot, so day-to-day use is one word:
#
#   mascot          지금 내 마스코트
#   mascot roll     오늘의 마스코트 뽑기 (하루 한 번)
#   mascot help     도움말
#
# Everything here just forwards to statusline.sh, which does the real work.

dir=$(CDPATH= cd -- "$(dirname -- "$0")" 2>/dev/null && pwd) || dir='.'
line="$dir/statusline.sh"

if [ ! -f "$line" ]; then
    echo "statusline.sh 를 찾을 수 없습니다: $line" >&2
    exit 1
fi

case "${1:-today}" in
    roll|r)          exec sh "$line" --roll ;;
    today|t|'')      exec sh "$line" --today ;;
    version|v|-v)    exec sh "$line" --version ;;
    *)               exec sh "$line" --help ;;
esac
